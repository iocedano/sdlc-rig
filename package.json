{
  "name": "sdlc-rig",
  "version": "0.1.0",
  "description": "Custom SDLC assistant (stories, plan, review, tests, release notes, security) built on githubnext/rig",
  "type": "module",
  "bin": {
    "sdlc": "./bin/sdlc.mjs"
  },
  "scripts": {
    "sdlc": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@github/copilot-sdk": "^1.0.0-beta.9",
    "rig": "github:githubnext/rig#v0.0.8",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "5.9"
  },
  "optionalDependencies": {
    "@openai/codex-sdk": "^0.162.0"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md"
  ]
}
